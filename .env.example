# Copy this file to .env and fill in the values. .env is gitignored.

# --- Browser build (PUBLIC) ---------------------------------------------
# Both of these are compiled into the JavaScript bundle and served to anyone
# who opens the site. That is expected: access is enforced by Postgres
# row-level security, not by keeping these secret.
# Supabase dashboard -> Settings -> API
#
# VITE_SUPABASE_ANON_KEY must be the "anon" / "public" key.
# NEVER put the service_role key here - it bypasses row-level security and
# would hand every visitor full read/write access to the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Local tooling (SECRET, never shipped to the browser) ----------------
# No VITE_ prefix, so Vite does not inline these into the bundle.

# Personal access token for the Supabase CLI.
# Dashboard -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=

# Direct Postgres connection string, used by psql to apply the SQL in db/
# and by npm run check:rls.
# Dashboard -> Settings -> Database -> Connection string -> URI
# (session pooler, port 5432; substitute your database password for [YOUR-PASSWORD])
SUPABASE_DB_URL=
