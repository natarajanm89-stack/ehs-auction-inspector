# Supabase — copy this file to .env and fill in the values.
# Both are safe to expose in the built bundle: access is enforced by
# Postgres row-level security, not by keeping these secret.
# Find them in: Supabase dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
